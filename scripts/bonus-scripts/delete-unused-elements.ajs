// ============================================================
// Delete Unused Elements — jArchi bonus script
// Removes all elements and relationships from the model
// that are not referenced in any view.
//
// Usage: run from Scripts → Script Manager (no selection needed).
// WARNING: this modifies the model — use with caution.
// ============================================================

const BATCH_LOG_INTERVAL = 1000;

const confirmed = window.confirm(
    "Этот скрипт удалит все элементы и связи, " +
    "которые не используются ни в одном представлении.\n\n" +
    "Продолжить?"
);

if (!confirmed) {
    console.log("Отменено пользователем");
} else {
    deleteUnusedConcepts();
}

function deleteUnusedConcepts() {
    console.show();
    console.log("Delete unused elements — start");

    let deletedCount = 0;

    $("concept").each(function (element) {
        if ($(element).objectRefs().isEmpty()) {
            element.delete();
            deletedCount++;

            if (deletedCount % BATCH_LOG_INTERVAL === 0) {
                console.log("Удалено: " + deletedCount + "...");
            }
        }
    });

    const message = "Удалено неиспользуемых элементов из модели: " + deletedCount;
    console.log("Delete unused elements — done. " + message);
    window.alert(message);
}
