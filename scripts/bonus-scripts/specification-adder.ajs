// ============================================================
// Specification Adder — jArchi bonus script
// Automatically adds <<${specialization}>> to the label
// expression of any element that has a specialization set
// but is missing it in the label.
//
// Usage: select a view in Archi, then run this script
//        via Scripts → Script Manager.
// ============================================================

const SPECIALIZATION_TEMPLATE = "<<${specialization}>>";

main();

// FIX: was written as `func main()` — JavaScript syntax error, script never ran
function main() {
    console.log("Specification adder — start");
    console.show();

    addSpecializationToLabels();

    console.log("Specification adder — done");
    window.alert("Готово: специализации добавлены в label");
}

/**
 * For each selected element that has a specialization but lacks
 * <<${specialization}>> in its labelExpression, prepend the template.
 */
function addSpecializationToLabels() {
    $(selection).children().each(function (element) {
        // FIX: check element != null before accessing .specialization
        if (element == null || element.specialization == null) return;

        if (element.labelExpression == null ||
                !element.labelExpression.contains(SPECIALIZATION_TEMPLATE)) {
            element.labelExpression = buildLabelExpression(element.name);
            console.log("Updated label for: " + element.name);
        }
    });
}

/**
 * Builds a label expression that shows the specialization tag above the element name.
 *
 * @param {string} elementName - the current element name
 * @returns {string} label expression with specialization template
 */
function buildLabelExpression(elementName) {
    return SPECIALIZATION_TEMPLATE + "\n" + elementName;
}
