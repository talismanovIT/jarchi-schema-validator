//script settings
let LOGGING_LEVEL = "INFO";//if DEBUG then we show result of console.log

//init
var alertResult = "";
var count = 1;
//старт скрипта, логика завернута в main
main();

function main() {

    console.log("Business process validator");
    console.show();

    printCurrentViewForDebug();

    //validation rules
    //common rules
    validateSpecificationInLabelAndLabelExists();

    validateThatElementsHaveRelationsOnDiagram();
    //business layer rules
    validateBusinessProcessOutRelations();
    validateBusinessActorOutRelations();
    validateBusinessServiceOutRelations();
    validateMultipleOutRelationsOfSameTypeShouldUseJunctionInstead();
    validateMultipleInRelationsOfSameTypeShouldUseJunctionInstead();
    //application layer rules
    //конфликтует со следующим правилом, временно убрано.
    // validateAppComponentHasRealizationOutRelation();
    validateAppComponentHasCorrectOutRelations();
    validateThatSyncAppInterfacesMustHaveComposition();
    validateDatabasePerService();
    validateAppInterfaceHasCorrectInAndOutRelations();
    validateAppServiceOutRelations();
    validateAppFunctionHasInAssignment();
    //validateMicroserviceCantCallSpa();
    validateQueueOrTopicOnlyFlowInAndOut();

    //alert report
    if (!alertResult.isEmpty()) {
        window.alert(alertResult);
    }
    console.log("Business process validator done");
}
//----------------------------END OF MAIN SCRIPT--------------------------------------

//validation functions
function validateBusinessProcessOutRelations() {
    $(selection).children().filter("business-process").outRels().each(function (rel) {
        println("BusinessProcess outRels");
        var outRelString = rel + "";
        println("rel=" + outRelString);
        if (outRelString.contains("triggering-relationship") || outRelString.contains("flow-relationship") || outRelString.contains("specialization-relationship")) {
            println("ok relation");
        } else {
            println("bad relation");
            // window.alert("bad relation");
            alertResult += validationErrorMessage(count, outRelString, rel.source.name);
            count++;
        }
        println("rel.source=" + rel.source);
        println("rel.target=" + rel.target);
        println("---------------------------");
    });
}


