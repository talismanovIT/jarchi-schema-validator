// ============================================================
// Helpers
// ============================================================

function addError(message) {
    alertResult += errorCount + ". " + message + "\n";
    errorCount++;
}

function println(text) {
    if (LOGGING_LEVEL === "DEBUG") {
        console.log(text);
    }
}

function printCurrentViewForDebug() {
    const views = $(selection).filter("archimate-diagram-model");
    if (views.size() === 1) {
        println('Selected view: "' + views.first().name + '"');
    }
}
