//todo оптимизация, если будет долго отрабатывать. пока O(n^2)
//возможны баги
function validateMicroserviceCantCallSpa() {
    println("\nvalidateMicroserviceCantCallSpa\n");
    $(selection).children().filter("application-component").each(function (element) {
        var childrenOfNotSpa = [];
        var i = 0;
        //проверка, что это не spa
        if (element.specialization != "spa") {
            //найти все out отношения
            $(element).outRels().each(function (rel) {
                if (rel.target.specialization == "spa") {
                    alertResult += `${count}. Элемент ${element.name} взаимодействует с spa ${rel.target.name} напрямую.\n`;
                    count++;
                    return;
                }

                // Сохраняем целевой элемент для дальнейшей проверки
                if (rel.target) {
                    childrenOfNotSpa.push(rel.target);
                    println("Добавлен целевой элемент:", rel.target.name);
                }

            });
            //добавить их в детей компонента
            //пробежаться по потомкам и проверить, что таргет не spa
        } else if (element.specialization == "spa") {
            //проверка2, что spa напрямую не вызывает app component
            $(element).outRels().each(function (rel) {
                if (rel.target.type == "application-component") {
                    alertResult += `${count}. Элемент ${element.name} взаимодействует с application-component ${rel.target.name} напрямую.\n`;
                    count++;
                    return;
                }
            });
        }
        println("childrenOfNotSpa=" + childrenOfNotSpa);
        // Проверяем цепочку вызовов
            for (var i = 0; i < childrenOfNotSpa.length; i++) {
                var childElement = childrenOfNotSpa[i];
                println("childElement=" + childElement);

                // ВАЖНО: оборачиваем childElement в $() для получения метода outRels()
                $(childElement).rels().each(function (rel2) {
                    if ((rel2.target && rel2.target.specialization == "spa") ||
                    (rel2.source && rel2.source.specialization == "spa")) {
                        alertResult += `${count}. Элемент ${element.name} взаимодействует с spa ${rel2.target.name} через ${childElement.name}.\n`;
                        count++;
                    }
                });
            }
        println("\n")
    });
}

