// ============================================================
// Business Process Validator — jArchi script
// Validates ArchiMate diagram elements and relationships
// against architecture rules for business and application layers.
//
// Usage: select a view in Archi, then run this script
//        via Scripts → Script Manager.
// ============================================================

// Settings
const LOGGING_LEVEL = "INFO"; // set to "DEBUG" to enable verbose console output

// ---- State (reset on each run) ----
let alertResult = "";
let errorCount  = 1;

main();

function main() {
    console.log("Business process validator — start");
    console.show();

    printCurrentViewForDebug();

    // ── Common rules ────────────────────────────────────────
    validateSpecificationInLabelAndLabelExists();
    validateThatElementsHaveRelationsOnDiagram();

    // ── Business layer rules ─────────────────────────────────
    validateBusinessProcessOutRelations();
    validateBusinessActorOutRelations();
    validateBusinessServiceOutRelations();
    validateMultipleOutRelationsOfSameTypeShouldUseJunctionInstead();
    validateMultipleInRelationsOfSameTypeShouldUseJunctionInstead();

    // ── Application layer rules ──────────────────────────────
    validateAppComponentHasCorrectOutRelations();
    validateThatSyncAppInterfacesMustHaveComposition();
    validateDatabasePerService();
    validateAppInterfaceHasCorrectInAndOutRelations();
    validateAppServiceOutRelations();
    validateAppFunctionHasInAssignment();
    validateQueueOrTopicOnlyFlowInAndOut();

    // ── Report ───────────────────────────────────────────────
    if (alertResult.length > 0) {
        window.alert(alertResult);
    }
    console.log("Business process validator — done");
}

// ============================================================
// Business layer validators
// ============================================================

function validateBusinessProcessOutRelations() {
    $(selection).children().filter("business-process").outRels().each(function (rel) {
        const relString = rel + "";
        println("BusinessProcess outRel: " + relString);

        const valid = relString.contains("triggering-relationship") ||
                      relString.contains("flow-relationship") ||
                      relString.contains("specialization-relationship");

        if (!valid) {
            addError("Элемент " + rel.source.name + " имеет некорректную связь " + relString);
        }
    });
}

function validateBusinessActorOutRelations() {
    $(selection).children().filter("business-actor").outRels().each(function (rel) {
        const relString = rel + "";
        println("BusinessActor outRel: " + relString);

        if (!relString.contains("assignment-relationship")) {
            addError("Элемент " + rel.source.name + " имеет некорректную связь " + relString);
        }
    });
}

function validateBusinessServiceOutRelations() {
    $(selection).children().filter("business-service").outRels().each(function (rel) {
        const relString = rel + "";
        println("BusinessService outRel: " + relString);

        if (!relString.contains("serving-relationship")) {
            addError("Элемент " + rel.source.name + " имеет некорректную связь " + relString);
        }
    });
}

/**
 * If a business-event or business-process has multiple outgoing relations of the same type,
 * a Junction (OR) should be used instead.
 *
 * FIX: moved forEach check outside the each() loop so it runs once after all
 * relations are counted — previously it fired on every iteration, producing duplicates.
 */
function validateMultipleOutRelationsOfSameTypeShouldUseJunctionInstead() {
    const countMap = new Map();

    $(selection).children().outRels().each(function (rel) {
        const srcType = rel.source.type;
        if (srcType !== "business-event" && srcType !== "business-process") return;

        const key = rel.source.name + "|" + (rel + "");
        countMap.set(key, (countMap.get(key) || 0) + 1);
    });

    countMap.forEach(function (value, key) {
        if (value > 1) {
            const parts    = key.split("|");
            const srcName  = parts[0];
            const relType  = parts[1];
            addError("Элемент " + srcName + " имеет несколько исходящих связей " + relType + ". Используйте Junction ИЛИ (OR)");
        }
    });
}

/**
 * If a business-event or business-process has multiple incoming relations of the same type,
 * a Junction (AND) should be used instead.
 *
 * FIX: same duplicate-report bug as the outRels variant — forEach now runs after the loop.
 */
function validateMultipleInRelationsOfSameTypeShouldUseJunctionInstead() {
    const countMap = new Map();

    $(selection).children().inRels().each(function (rel) {
        const tgtType = rel.target.type;
        if (tgtType !== "business-event" && tgtType !== "business-process") return;

        const key = rel.target.name + "|" + (rel + "");
        countMap.set(key, (countMap.get(key) || 0) + 1);
    });

    countMap.forEach(function (value, key) {
        if (value > 1) {
            const parts   = key.split("|");
            const tgtName = parts[0];
            const relType = parts[1];
            addError("Элемент " + tgtName + " имеет несколько входящих связей " + relType + ". Используйте Junction И (AND)");
        }
    });
}

// ============================================================
// Application layer validators
// ============================================================

function validateAppComponentHasCorrectOutRelations() {
    const VALID_OUT_RELATIONS = [
        "realization-relationship",
        "triggering-relationship",
        "composition-relationship",
        "aggregation-relationship",
        "assignment-relationship",
        "access-relationship",
        "flow-relationship"
    ];

    $(selection).children().filter("application-component").outRels().each(function (rel) {
        const relString = rel + "";
        println("ApplicationComponent outRel: " + relString);

        const valid = VALID_OUT_RELATIONS.some(function (type) {
            return relString.contains(type);
        });

        if (!valid) {
            addError("Элемент " + rel.source.name + " имеет некорректную связь " + relString);
        }
    });
}

/**
 * Sync interfaces (REST, SOAP, gRPC, stored-procedure) must have an inbound composition.
 * Async interfaces (queue, topic) must NOT have an inbound composition.
 */
function validateThatSyncAppInterfacesMustHaveComposition() {
    const SYNC_SPECIALIZATIONS  = ["soap", "grpc", "stored-procedure"];
    const ASYNC_SPECIALIZATIONS = ["queue", "topic"];
    const REST_HTTP_METHODS     = ["GET", "POST", "PUT", "DELETE", "PATCH"];

    $(selection).children().filter("application-interface").each(function (element) {
        const spec      = element.specialization;
        const name      = element.name;
        const isSync    = SYNC_SPECIALIZATIONS.indexOf(spec) >= 0 ||
                          REST_HTTP_METHODS.some(function (m) { return name.contains(m); });
        const isAsync   = ASYNC_SPECIALIZATIONS.indexOf(spec) >= 0;

        let hasComposition = false;
        $(element).inRels().each(function (rel) {
            if ((rel + "").contains("composition-relationship")) {
                hasComposition = true;
            }
        });

        if (isSync && !hasComposition) {
            addError("Элемент " + name + " (sync interface) не имеет входящей связи композиция");
        } else if (isAsync && hasComposition) {
            addError("Элемент " + name + " (queue/topic) не должен иметь связи композиция");
        } else if (!isSync && !isAsync) {
            println("Неизвестный тип интерфейса: " + name + " spec=" + spec + " — пропускаем");
        }
    });
}

/**
 * Database per service: a data-object (DB) must have only one incoming access relation.
 */
function validateDatabasePerService() {
    $(selection).children().filter("data-object").each(function (element) {
        let accessCount = 0;
        $(element).inRels().each(function (rel) {
            if ((rel + "").contains("access-relationship")) {
                accessCount++;
            }
        });

        if (accessCount > 1) {
            addError("Элемент " + element.name + " (data-object) имеет " + accessCount +
                     " входящих access relation. Должна быть только одна (Database per Service)");
        }
    });
}

function validateAppInterfaceHasCorrectInAndOutRelations() {
    const VALID_IN  = ["flow-relationship", "triggering-relationship", "composition-relationship"];
    const VALID_OUT = ["flow-relationship"];

    $(selection).children().filter("application-interface").each(function (element) {
        $(element).inRels().each(function (rel) {
            const relString = rel + "";
            const valid = VALID_IN.some(function (t) { return relString.contains(t); });
            if (!valid) {
                addError("Элемент " + element.name + " имеет некорректную входящую связь: " + relString);
            }
        });

        $(element).outRels().each(function (rel) {
            const relString = rel + "";
            const valid = VALID_OUT.some(function (t) { return relString.contains(t); });
            if (!valid) {
                addError("Элемент " + element.name + " имеет некорректную исходящую связь: " + relString);
            }
        });
    });
}

function validateAppServiceOutRelations() {
    const VALID_OUT = ["serving-relationship", "realization-relationship"];

    $(selection).children().filter("application-service").outRels().each(function (rel) {
        const relString = rel + "";
        println("ApplicationService outRel: " + relString);

        const valid = VALID_OUT.some(function (t) { return relString.contains(t); });
        if (!valid) {
            // FIX: was incorrectly using `var element = $(element)` (element undefined in this scope)
            addError("Элемент " + rel.source.name + " имеет некорректную исходящую связь " + relString);
        }
    });
}

function validateAppFunctionHasInAssignment() {
    $(selection).children().filter("application-function").each(function (element) {
        $(element).inRels().each(function (rel) {
            const relString = rel + "";
            if (!relString.contains("assignment-relationship")) {
                addError("Элемент " + rel.source.name + " имеет некорректную входящую связь " + relString);
            }
        });
    });
}

/**
 * queue and topic interfaces may only have flow-relationship in and out.
 */
function validateQueueOrTopicOnlyFlowInAndOut() {
    $(selection).children().filter("application-interface").each(function (element) {
        if (element.specialization !== "queue" && element.specialization !== "topic") return;

        $(element).outRels().concat && $(element).outRels().each(function (rel) {
            const relString = rel + "";
            if (!relString.contains("flow-relationship")) {
                addError("Элемент " + rel.source.name + " (queue/topic) имеет некорректную исходящую связь " + relString);
            }
        });

        $(element).inRels().each(function (rel) {
            const relString = rel + "";
            if (!relString.contains("flow-relationship")) {
                addError("Элемент " + rel.source.name + " (queue/topic) имеет некорректную входящую связь " + relString);
            }
        });
    });
}

// ============================================================
// Common validators
// ============================================================

/**
 * Elements with a specialization must have <<${specialization}>> in their label expression.
 */
function validateSpecificationInLabelAndLabelExists() {
    $(selection).children().each(function (element) {
        if (element == null || element.specialization == null) return;

        if (element.labelExpression == null ||
                !element.labelExpression.contains("<<${specialization}>>")) {
            addError("Элемент " + element.name + " не проставил specialization в label");
        }
    });
}

const ELEMENTS_REQUIRING_RELATIONS = [
    // Business layer
    "business-role", "business-actor", "business-collaboration",
    "business-interface", "business-process", "business-function",
    "business-interaction", "business-event", "business-service",
    "business-object", "business-contract", "business-representation",
    "business-product",
    // Application layer
    "application-collaboration", "application-interface",
    "application-process", "application-function", "application-interaction",
    "application-event", "application-service", "data-object",
    "application-component"
];

function validateThatElementsHaveRelationsOnDiagram() {
    $(selection).children().each(function (element) {
        if (ELEMENTS_REQUIRING_RELATIONS.indexOf(element.type) < 0) return;

        if ($(element).rels().size() === 0) {
            addError("Элемент " + element.name + " (" + element.type + ") не имеет связей на диаграмме");
        }
    });
}

