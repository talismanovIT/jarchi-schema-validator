function validateThatElementsHaveRelationsOnDiagram() {
    //переписать на списки
    $(selection).children().each(function (element) {

        var elementTypes = [
            "business-role", "business-actor", "business-collaboration",
            "business-interface", "business-process", "business-function",
            "business-interaction", "business-event", "business-service",
            "business-object", "business-contract", "business-representation",
            "business-product",
            //application layer
            "application-collaboration", "application-interface",
            "application-process", "application-function", "application-interaction",
            "application-event", "application-service", "data-object",
            "application-component"
        ];
        if (elementTypes.indexOf(element.type) >= 0) {
            var hasAnyRels = $(element).rels().size() > 0;

            if (!hasAnyRels) {
                alertResult += `${count}. Элемент ${element.name} (${element.type}) не имеет связей.\n`;
                count++;
            }
        }
    });
}

function validateThatSyncAppInterfacesMustHaveComposition() {
    println("validateThatSyncAppInterfacesMustHaveComposition");
    $(selection).children().filter("application-interface").each(function (element) {

        if (element.specialization == "soap" ||
            element.specialization == "grpc" ||
            element.specialization == "stored-procedure" ||
            element.name.contains("GET") ||
            element.name.contains("POST") ||
            element.name.contains("PUT") ||
            element.name.contains("DELETE") ||
            element.name.contains("PATCH")) {
            var hasComposition = false;
            $(element).inRels().each(function (rel) {
                var outRelString = rel + "";
                println("rel=" + outRelString);
                if (outRelString.contains("composition-relationship")) {
                    hasComposition = true;
                }
            });

            if (hasComposition) {
                println("validateThatSyncAppIntefacesMustHaveComposition is ok");
            } else {
                println("validateThatSyncAppIntefacesMustHaveComposition is bad");
                alertResult += `${count}. Элемент ${element.name} не имеет связи композиция.\n`;
                count++;
            }
        } else if (element.specialization == "queue" ||
            element.specialization == "topic"
        ) {
            //topic queue and others
            var hasComposition = false;
            $(element).inRels().each(function (rel) {
                var outRelString = rel + "";
                println("rel=" + outRelString);
                if (outRelString.contains("composition-relationship")) {
                    hasComposition = true;
                }
            });

            if (hasComposition) {
                println("validateThatSyncAppIntefacesMustHaveComposition is bad");
                alertResult += `${count}. Элемент ${element.name} не должен иметь связи композиция.\n`;
                count++;
            } else {
                println("validateThatSyncAppIntefacesMustHaveComposition is ok");
            }
        } else {
            println("unknown interface, should be REST, soap, grpc, stored-procedure, queue, topic");
        }
    });
}

function validateAppComponentHasCorrectOutRelations() {

    function allTypesValid(outRelString) {
        return outRelString.contains("realization-relationship") ||
            outRelString.contains("triggering-relationship") ||
            outRelString.contains("composition-relationship") ||
            outRelString.contains("aggregation-relationship") ||
            outRelString.contains("assignment-relationship") ||
            outRelString.contains("access-relationship") ||
            outRelString.contains("flow-relationship");
    }

    $(selection).children().filter("application-component").outRels().each(function (rel) {
        console.log("Application Component outRels");
        var outRelString = rel + "";
        console.log("rel=" + outRelString);
        //realization-relationship обязательная
        console.log("allTypesValid=" + allTypesValid(outRelString));
        if (allTypesValid(outRelString)) {
            console.log("ok relation");
        } else {
            console.log("bad relation");
            // window.alert("bad relation");
            //alertResult += count + ". business-service out relation can't be " + outRelString + "rel.source.name=" + rel.source.name + "\n";
            alertResult += validationErrorMessage(count, outRelString, rel.source.name);
            count++;
        }
        console.log("\n")
    });
}

function validateDatabasePerService() {
    println("validateDatabasePerService");
    $(selection).children().filter("data-object").each(function (element) {
        const relationToCountMap = new Map();
        //todo add access relation rule
        $(element).inRels().each(function (rel) {
            println("assume we have only access relation");
            var inRelString = rel + "";
            var key = inRelString;
            var countValue = relationToCountMap.get(key);
            println("countValue=" + countValue);

            if (countValue == undefined || countValue == 0) {
                relationToCountMap.set(key, 1);
            } else {
                relationToCountMap.set(key, countValue + 1);
            }
            println("rel=" + inRelString);
        });
        relationToCountMap.forEach((value, key) => {
            if (value > 1) {
                alertResult += `${count}. Элемент ${element.name} является базой данных. Должен иметь только одну access relation.\n`;
                count++;
            }
        })
        println(relationToCountMap);

    });
}

function validateAppInterfaceHasCorrectInAndOutRelations() {
    console.log("validateAppInterfaceHasCorrectInAndOutRelations")
    $(selection).children().filter("application-interface").each(function (element) {
        $(element).inRels().each(function (rel) {
            var relString = rel + "";
            println("rel=" + relString);
            if (relString.contains("flow-relationship") ||
                relString.contains("triggering-relationship") ||
                relString.contains("composition-relationship")
            ) {
                println("ok relation");
            } else {
                println("bad relation");
                alertResult += `${count}. Элемент ${element.name} имеет не корректную in связь ${rel.target.name}.\n`;
                count++;
            }
        });

        $(element).outRels().each(function (rel) {
            var relString = rel + "";
            println("rel=" + relString);
            if (relString.contains("flow-relationship")) {
                println("ok relation");
            } else {
                println("bad relation");
                alertResult += `${count}. Элемент ${element.name} имеет не корректную out связь ${rel.target.name} напрямую.\n`;
                count++;
            }
        });
    });
}

