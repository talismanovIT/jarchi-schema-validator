function validateMultipleOutRelationsOfSameTypeShouldUseJunctionInstead() {
    const relationToCountMap = new Map();
    $(selection).children().outRels().each(function (rel) {
        //лучше выше отфильтровать, костыльно, но быстро
        if(rel.source.type == "business-event" || rel.source.type == "business-process") {
            println("outRels of the same type have to be changed to junction");
            var outRelString = rel + "";
            var sourceName = rel.source.name;
            var key = sourceName + "|" + outRelString;
            var countValue = relationToCountMap.get(key);
            println("countValue=" + countValue);
            if (countValue == undefined || countValue == 0) {
                relationToCountMap.set(key, 1);
            } else {
                relationToCountMap.set(key, countValue + 1);
            }
            println("rel=" + outRelString);

            relationToCountMap.forEach((value, key) => {
                if (value > 1) {
                    alertResult += `${count}. Элемент ${sourceName} имеет несколько исходящих связей ${outRelString}. Используйте Junction ИЛИ(OR)\n`;
                    count++;
                }
            })
            println(relationToCountMap);
        }
    });
}

function validateMultipleInRelationsOfSameTypeShouldUseJunctionInstead() {
    const relationToCountMap = new Map();
    $(selection).children().inRels().each(function (rel) {
        if(rel.target.type == "business-event" || rel.target.type == "business-process") {
            println("inRels of the same type have to be changed to junction");
            var inRelString = rel + "";
            var targetName = rel.target.name;
            var key = targetName + "|" + inRelString;
            var countValue = relationToCountMap.get(key);
            println("countValue=" + countValue);
            if (countValue == undefined || countValue == 0) {
                relationToCountMap.set(key, 1);
            } else {
                relationToCountMap.set(key, countValue + 1);
            }
            println("rel=" + inRelString);

            relationToCountMap.forEach((value, key) => {
                if (value > 1) {
                    alertResult += `${count}. Элемент ${targetName} имеет несколько входящих связей ${inRelString}. Используйте Junction И(AND)\n`;
                    count++;
                }
            })
            println(relationToCountMap);
        }
    });
}

function validateSpecificationInLabelAndLabelExists() {
    println("validateSpecificationInLabelAndLabelExists");
    $(selection).children().each(function (element) {
        println("----------element.specialization=" + element.specialization);
        if (element.specialization != null) {
            if (element != null) {
                if (element.labelExpression == null || !element.labelExpression.contains("<<${specialization}>>")) {
                    alertResult += `${count}. Элемент ${element.name} не проставил specialization в label.\n`;
                    count++;
                }
            }
        }
    });
}

