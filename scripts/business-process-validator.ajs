//helper functions

function println(text) {
    if ("DEBUG" == LOGGING_LEVEL) {
        console.log(text);
    }
}

function validationErrorMessage(count, outRelString, sourceName) {
    // return `${count}. business-service out relation can't be ${outRelString}rel.source.name=${sourceName}\n`;
    return `${count}. Элемент ${sourceName} имеет некорректную связь ${outRelString}\n`;
}

function printCurrentViewForDebug() {
    if ($(selection).filter("archimate-diagram-model").size() == 1) {
        // $(selection).filter("archimate-diagram-model") is a collection, so one has to apply '.first' to make it a element
        var view = $(selection).filter("archimate-diagram-model").first();
        println('Existing selected view is : "', view.name, '"');
    }
}